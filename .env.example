# Copy to .env and fill in. .env is gitignored.

# Bitpanda (One Trading) exchange API key — used by src/feeds/bitpanda.py
BITPANDA_API_KEY=

# Other feed credentials (optional; public market data does not need them)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# DERIBIT_API_KEY=
# DERIBIT_API_SECRET=
# DERIBIT_TESTNET=
# FRED_API_KEY=

# Interactive Brokers — connects to a local TWS / IB Gateway API socket
# (no API key; enable "ActiveX and Socket Clients" in TWS API settings first).
# Paper TWS: 7497 (default) | Live TWS: 7496 | Gateway: 4002 paper / 4001 live
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1
